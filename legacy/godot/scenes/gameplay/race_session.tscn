[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/gameplay/race_session.gd" id="1_session"]
[ext_resource type="Script" path="res://scripts/track/circuit.gd" id="2_circuit"]
[ext_resource type="PackedScene" path="res://scenes/vehicles/formula_car.tscn" id="3_car"]
[ext_resource type="Script" path="res://scripts/camera/race_camera.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="5_hud"]
