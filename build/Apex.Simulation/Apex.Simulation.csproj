<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the engine-independent Apex.Simulation sources exactly as Unity
       does (netstandard2.1, C# 9, no UnityEngine reference). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Apex</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/com.projectapex.game/Runtime/Simulation/**/*.cs" />
  </ItemGroup>
</Project>
